#
# Squire local environment
#

# Required for answer generation
ANTHROPIC_API_KEY=your_key_here
# Required for rule indexing and retrieval
VOYAGE_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here

# Google OAuth (required for web UI login)
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret
# Optional: defaults to the request origin in local dev.
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Session cookie signing / CSRF derivation
# Generate one with: openssl rand -base64 48
SESSION_SECRET=replace_with_random_32_plus_character_string

# Comma-separated email allowlist for web UI login
SQUIRE_ALLOWED_EMAILS=your-email@example.com

# LangSmith tracing / observability
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=squire-evals
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=

# Optional Sentry app observability.
# Missing SENTRY_DSN is a local/test no-op. Production DSNs are Fly secrets.
# SENTRY_DSN=
# SENTRY_RELEASE=local-dev

# Optional eval runner defaults. CLI flags override these values.
# SQUIRE_EVAL_PROVIDER=anthropic
# SQUIRE_EVAL_MODEL=claude-sonnet-4-6
# SQUIRE_EVAL_RUN_LABEL=local-eval
#
# Future provider runner knobs. Leave unset until the provider runner supports them.
# SQUIRE_EVAL_REASONING_EFFORT=
# SQUIRE_EVAL_MAX_OUTPUT_TOKENS=
# SQUIRE_EVAL_TIMEOUT_MS=
# SQUIRE_EVAL_TOOL_LOOP_LIMIT=

# Server environment — development enables dev-only routes and no-cache asset serving
NODE_ENV=development

# Squire trace environment for LangSmith metadata/tags.
# Defaults to NODE_ENV when unset.
SQUIRE_ENV=development

# Daily LLM spend circuit breaker. Defaults shown here match the app defaults.
# Budget accounting is local Postgres state; LangSmith is observability only.
# SQUIRE_LLM_DAILY_BUDGET_USD=10
# SQUIRE_LLM_BUDGET_WARNING_THRESHOLD=0.8
# SQUIRE_LLM_INPUT_USD_PER_MILLION_TOKENS=3
# SQUIRE_LLM_OUTPUT_USD_PER_MILLION_TOKENS=15
# SQUIRE_LLM_CACHE_CREATION_INPUT_USD_PER_MILLION_TOKENS=6
# SQUIRE_LLM_CACHE_READ_INPUT_USD_PER_MILLION_TOKENS=0.3

# Redis/Valkey-compatible backend for app-level rate limits.
# Required in production. Local dev falls back to in-process limits when unset.
# REDIS_URL=redis://localhost:6379

# Optional server overrides
# Production defaults to PORT=8080 and HOST=0.0.0.0.
# Local dev without PORT keeps the checkout/worktree-managed port behavior.
# PORT=8080
# HOST=0.0.0.0
#
# Required in production when the app is locked behind CloudFront.
# CloudFront sends this value as X-Origin-Secret; /api/live and /api/health
# bypass the check so Fly machine health checks keep working.
# ORIGIN_SHARED_SECRET=
#
# Public base URL used in OAuth metadata responses
# SQUIRE_BASE_URL=http://localhost:3000

# Optional Postgres overrides
# By default, local dev uses checkout-managed databases on the local docker-compose service.
# Main checkout uses `squire` / `squire_test`; linked worktrees derive names from the checkout path.
# DATABASE_URL=postgres://squire:squire@localhost:5432/squire
# TEST_DATABASE_URL=postgres://squire:squire@localhost:5432/squire_test

# Optional data-path override for Gloomhaven Secretariat source data
# GHS_DATA_DIR=/absolute/path/to/gloomhavensecretariat/data/fh

# Advanced local override for worktree port-claim bookkeeping
# SQUIRE_PORT_CLAIM_DIR=/absolute/path/to/port-claims

# Opt in to the /dev/login route (plain POST to mint a session without Google OAuth).
# Required since SQR-106 as a third positive gate alongside NODE_ENV and DATABASE_URL.
# scripts/preview-serve.sh sets this automatically for Claude Code preview.
# Set it here only if you also want it available when running `npm run serve` directly.
# SQUIRE_DEV_LOGIN=1
