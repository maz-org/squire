{
  "name": "squire",
  "version": "0.1.25",
  "description": "Frosthaven AI assistant with RAG over rulebooks",
  "type": "module",
  "engines": {
    "node": ">=26.1.0 <27"
  },
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run lint:css && npm run lint:md && npm run format:check && npm test",
    "build:web-assets": "node scripts/build-web-assets.ts",
    "index": "node src/index-docs.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.ts",
    "db:migrate:test": "NODE_ENV=test node scripts/db-migrate.ts",
    "db:reset": "node scripts/db-reset.ts",
    "db:reset:test": "NODE_ENV=test node scripts/db-reset.ts",
    "seed": "npm run seed:cards && npm run seed:scenario-section-books && npm run seed:unlock-graphs && npm run seed:concepts && npm run seed:corrections && npm run seed:cross-surface",
    "seed:cards": "node scripts/seed-cards.ts",
    "seed:scenario-section-books": "node scripts/seed-scenario-section-books.ts",
    "seed:unlock-graphs": "node scripts/seed-unlock-graphs.ts",
    "seed:concepts": "node scripts/seed-concepts.ts",
    "seed:corrections": "node scripts/seed-corrections.ts",
    "seed:cross-surface": "node scripts/seed-cross-surface.ts",
    "migrate:live-gh2e": "node scripts/migrate-live-gh2e.ts",
    "seed:dev-user": "node scripts/seed-dev-user.ts",
    "seed:dev": "npm run seed:cards && npm run seed:scenario-section-books && npm run seed:unlock-graphs && npm run seed:concepts && npm run seed:corrections && npm run seed:cross-surface && npm run seed:dev-user",
    "sessions:sweep-expired": "node scripts/sweep-expired-sessions.ts",
    "production-data:verify-db-url": "node scripts/check-production-data.ts verify-url",
    "production-data:check": "node scripts/check-production-data.ts",
    "production-data:smoke": "node scripts/check-production-data.ts smoke",
    "production-data:truncate-embeddings": "node scripts/check-production-data.ts truncate-embeddings",
    "query": "node src/query.ts",
    "serve": "node src/server.ts",
    "eval": "node eval/run.ts",
    "eval:judge-calibration": "node eval/judge-calibration.ts",
    "pdf-extraction:run": "node eval/pdf-extraction/run.ts",
    "rulebook:refresh:gh2": "node scripts/refresh-gh2-rulebook-source.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.split.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:split": "vitest run --config vitest.split.config.ts",
    "test:timing": "mkdir -p .gstack/test-timings && npm run test:unit -- --reporter=json --outputFile=.gstack/test-timings/unit.json && npm run test:db -- --reporter=json --outputFile=.gstack/test-timings/db.json && node scripts/summarize-test-timings.ts --fail-over-threshold unit=.gstack/test-timings/unit.json db=.gstack/test-timings/db.json",
    "test:coverage": "vitest run --coverage --config vitest.split.config.ts",
    "test:coverage:serial": "vitest run --coverage --exclude test/import-scenario-section-books.test.ts",
    "test:slow:pdf": "vitest run test/import-scenario-section-books.test.ts",
    "test:full": "vitest run",
    "test:coverage:full": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e:api-agent": "node scripts/e2e-api-agent-smoke.ts",
    "e2e:browser:prepare": "npm run db:migrate:test && NODE_ENV=test npm run seed:dev-user",
    "e2e:browser": "npm run e2e:browser:prepare && playwright test --config=playwright.e2e.config.ts",
    "agent:check": "node scripts/check-agent-parity.ts",
    "sentry:test-event": "node scripts/send-sentry-safe-test-event.ts",
    "sentry:app-health": "node scripts/sync-sentry-app-health.ts",
    "sentry:scrubbing": "node scripts/configure-sentry-scrubbing.ts",
    "sentry:usage-guardrails": "node scripts/print-sentry-usage-guardrails.ts",
    "security:alerts:dry-run": "SECURITY_ALERT_DRY_RUN=1 node scripts/sync-security-alerts-to-linear.ts",
    "security:alerts:validate-config": "node scripts/sync-security-alerts-to-linear.ts --validate-config",
    "lint": "eslint src/ test/ scripts/",
    "lint:css": "stylelint 'src/web-ui/**/*.css'",
    "lint:md": "markdownlint-cli2 '**/*.md' '#node_modules' '#data' '#eval/results' '#.beads' '#.gstack'",
    "lint:actions": "actionlint",
    "format": "prettier --write src/ test/",
    "format:check": "prettier --check src/ test/",
    "hooks:install": "node scripts/setup-git-hooks.ts",
    "prepare": "npm run hooks:install"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write",
      "markdownlint-cli2 --fix"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.1098.0",
    "@aws-sdk/client-textract": "^3.1098.0",
    "@hono/node-server": "^2.0.12",
    "@langchain/anthropic": "^1.5.2",
    "@langchain/core": "^1.2.3",
    "@langchain/langgraph": "^1.4.8",
    "@linear/sdk": "^88.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.9.0",
    "@opentelemetry/instrumentation": "^0.220.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@redis/client": "^6.1.0",
    "@sentry/node": "^10.68.0",
    "@sentry/opentelemetry": "^10.57.0",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "deepagents": "^1.12.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "google-auth-library": "^10.9.1",
    "hono": "^4.12.32",
    "htmx.org": "^2.0.10",
    "langchain": "^1.5.4",
    "langsmith": "^0.7.17",
    "markdown-it": "^14.3.0",
    "parse5": "^8.0.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.21.0",
    "rate-limiter-flexible": "^11.2.0",
    "tailwindcss": "^4.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "2.0.11"
    },
    "brace-expansion": "5.0.7",
    "esbuild": "0.28.1",
    "ip-address": "10.1.1",
    "sharp": "0.34.5",
    "smol-toml": "1.6.1",
    "fast-uri": "3.1.4",
    "@grpc/proto-loader": {
      "protobufjs": "7.6.5"
    },
    "onnx-proto": {
      "protobufjs": "7.6.5"
    },
    "@opentelemetry/otlp-transformer": {
      "protobufjs": "8.2.0"
    }
  }
}
